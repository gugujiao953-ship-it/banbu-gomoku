{
  "name": "banbu-gomoku",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:ai": "node scripts/prepare-ai-assets.mjs",
    "build": "npm run prepare:ai && tsc -b && vite build && node scripts/check-dist-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "qa:smoke": "node scripts/run-qa.mjs smoke",
    "qa:browser": "node scripts/run-qa.mjs browser",
    "qa:visual": "node qa/visual-ui-regression.mjs",
    "qa:full": "node scripts/run-qa.mjs full",
    "android:sync": "npm run build && cap sync android && node scripts/strip-android-engine-pack.mjs",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-android-release.ps1",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.1",
    "@vitejs/plugin-react": "6.1.0",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-legacy": "^8.2.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "onnxruntime-web": "1.24.1",
    "playwright": "1.62.1",
    "terser": "^5.51.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
